{
  "name": "ig-album-downloader",
  "displayName": "IG Album Downloader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bulk-download photos, videos and reels from Instagram profiles, saved collections, highlights, stories and hashtag searches.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "icons": "python3 scripts/generate-icons.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "npm run build && node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@yaireo/tagify": "^4.39.0",
    "antd": "~5.29.3",
    "dayjs": "^1.11.13",
    "fast-xml-parser": "^5.2.5",
    "lodash-es": "^4.17.21",
    "mediabunny": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@eslint/js": "^9.39.0",
    "@types/chrome": "^0.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/yaireo__tagify": "^4.27.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
